BOT_PREFIX=.
# Assinatura discreta nos cartões do bot e pack padrão das figurinhas (vazio = sem assinatura)
BOT_BRAND=by 𝖒𝖔𝖓𝖙𝖝2_
BOT_TZ=America/Sao_Paulo
LOG_LEVEL=info
VIEW_ONCE_AUTO=1
VIEW_ONCE_RETRIES=15
STATUS_SAVER=0
STATUS_ONLY_WATCH=1
MEDIA_VAULT=1
MEDIA_ONLY_WATCH=0
ANTI_DELETE=1
ANTI_EDIT=1
REACTION_MONITOR=1
PRESENCE_MONITOR=1
READ_RECEIPT_MONITOR=1
CALL_MONITOR=1
GROUP_RADAR=1
FORWARD_MONITOR=1
DEVICE_MONITOR=1
SMART_ALERTS=1
PROFILE_MONITOR=0
AUTO_ARCHIVE=1
AUTO_EVENTS=1
STICKER_DEFAULT=1
# Figurinhas: pack/autor padrão (também dá pra mudar pelo chat: .sticker pack Nome | Autor)
STICKER_PACK=by 𝖒𝖔𝖓𝖙𝖝2_
STICKER_AUTHOR=
# Formato padrão da figurinha: fit (imagem inteira, sem cortar), crop (preenche o quadrado), full, circle, round
STICKER_FIT=fit
# Duração máxima de figurinha animada (1-15 s)
STICKER_MAX_SECONDS=10
STICKER_MAX_STATIC_KB=100
STICKER_MAX_ANIMATED_KB=500
# Reage com ⏳/❌ na mensagem do comando
STICKER_REACT=1
# Tudo que você enviar (imagem/vídeo/GIF) para o seu próprio chat vira figurinha
STICKER_AUTO_SELF=0
MARK_ONLINE=0
MAX_MEDIA_MB=80
KEEP_RAW_DAYS=21
# Retenção automática (manutenção diária; View Once e cofre NUNCA são apagados)
MEDIA_KEEP_DAYS=30
MEDIA_MAX_GB=4
LOG_MAX_MB=10

# Opcional: override manual no formato 2,3000,REVISAO
# Use somente quando a consulta ao WhatsApp Web estiver indisponível.
WA_VERSION_OVERRIDE=

DEFAULT_QUERY_TIMEOUT_MS=60000
CONNECT_TIMEOUT_MS=30000
KEEP_ALIVE_INTERVAL_MS=25000
RETRY_REQUEST_DELAY_MS=1000
INIT_QUERIES_RECOVERY_MS=8000
HEALTH_PROBE_INTERVAL_MS=300000
HEALTH_PROBE_TIMEOUT_MS=20000
